        <mxCell id="_qG_SJisv5SnWYnWGIV6-14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Se lo stato dell&#39;Evento è &quot;in corso&quot; (lavori preparatori iniziati), l&#39;annullamento richiede la generazione di una penale (&lt;code data-path-to-node=&quot;14,1,0&quot; data-index-in-node=&quot;173&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;penaleApplicata&lt;/font&gt;&lt;/code&gt;&amp;nbsp;= si) a meno che l&#39;Organizzatore non inserisca una motivazione testuale per la deroga. L&#39;eliminazione invece non può essere effettuata." vertex="1">
          <mxGeometry height="113" width="240" x="20" y="290" as="geometry" />
        </mxCell>
        <mxCell id="_qG_SJisv5SnWYnWGIV6-15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Tutte le&amp;nbsp;&lt;i data-path-to-node=&quot;14,0,0&quot; data-index-in-node=&quot;32&quot;&gt;istanze&lt;/i&gt;&amp;nbsp;generate da una&amp;nbsp;&lt;i data-path-to-node=&quot;14,0,0&quot; data-index-in-node=&quot;56&quot;&gt;Ricorrenza&lt;/i&gt;&amp;nbsp;ereditano di default le impostazioni dell&#39;&amp;nbsp;&lt;i data-path-to-node=&quot;14,0,0&quot; data-index-in-node=&quot;110&quot;&gt;Evento capofila.&lt;/i&gt;" vertex="1">
