        <mxCell id="cZMs2C7KkQb-unPeTSbi-104" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;div&gt;Il Cuoco che esegue il Compito&amp;nbsp;&lt;/div&gt;&lt;div&gt;deve essere disponibile&amp;nbsp;&lt;/div&gt;&lt;div&gt;nel Turno in cui lo svolge&amp;nbsp;&lt;/div&gt;" vertex="1">
