        </mxCell>
        <mxCell id="_qG_SJisv5SnWYnWGIV6-17" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;font face=&quot;Helvetica&quot;&gt;Se un Menù non è confermato (&lt;/font&gt;&lt;font face=&quot;Helvetica&quot;&gt;approvato&lt;/font&gt;&lt;font face=&quot;monospace&quot;&gt;&amp;nbsp;= no&lt;/font&gt;), il Sistema deve notificare l&#39;organizzatore durante l&#39;assegnazione del Personale, pur permettendo l&#39;operazione." vertex="1">
